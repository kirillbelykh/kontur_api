CHZ_BRIDGE_TOKEN=
CHZ_BRIDGE_ENABLED=
# Приём заявок ЧЗ из WMS: 0.0.0.0 — слушать сеть (нужно для WMS-колбэков),
# 127.0.0.1 — только локально (для ПК, которым приём из WMS не нужен).
# KONTUR_CHZ_BRIDGE_HOST имеет приоритет над легаси-именем CHZ_BRIDGE_HOST.
CHZ_BRIDGE_HOST=
CHZ_BRIDGE_PORT=
# Cookies are shared automatically between PCs on the same LAN (port 8791,
# same CHZ_BRIDGE_TOKEN). No IP list. Selenium runs only if nobody answers.
# KONTUR_COOKIE_SHARE=
WMS_BOUND_USER=
# Optional: load React from Vite instead of frontend/dist
# VITE_DEV_URL=
